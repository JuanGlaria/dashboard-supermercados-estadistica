# Puerto del server. En desarrollo debe coincidir con SERVER_PORT de client/.env; en producción, con el proxy_pass de nginx.
PORT=6001
# Producción: NODE_ENV=production activa cookie Secure (requiere HTTPS).
NODE_ENV=
# Zona horaria del proceso (define qué es "hoy"). Default America/Argentina/Buenos_Aires.
TZ=
# Subpath donde se publica el panel (ej. /dash), sin barra final. Vacío = raíz.
# Debe coincidir con VITE_BASE del build del client (ej. VITE_BASE=/dash/). El server sirve client/dist y la API bajo este prefijo.
BASE_PATH=
# Path de la cookie de sesión. Vacío = usa BASE_PATH (o / si no hay).
COOKIE_PATH=
# Solo si el client se sirve desde otro origen que el server. Vacío = sin CORS (same-origin).
CORS_ORIGIN=
JWT_SECRET=cambiar_este_secreto

# Branding del cliente (opcional). Si se omite, cae a los defaults genéricos.
NOMBRE_CLIENTE=
LOGO_URL=
FAVICON_URL=
COLOR_PRIMARY=
# Minutos entre refrescos automáticos del dashboard (vacío o 0 = sin auto-refresh)
REFRESCO_MINUTOS=

# Lista de sucursales del cliente, separadas por coma. Cada id define el resto
# de las variables de abajo (DB_<ID>_*, SUCURSAL_<ID>_NOMBRE opcional).
SUCURSALES=lavalle,savio,somisa

SUCURSAL_LAVALLE_NOMBRE=
DB_LAVALLE_SERVER=
DB_LAVALLE_PORT=1433
DB_LAVALLE_DATABASE=
DB_LAVALLE_USER=
DB_LAVALLE_PASSWORD=

SUCURSAL_SAVIO_NOMBRE=
DB_SAVIO_SERVER=
DB_SAVIO_PORT=1433
DB_SAVIO_DATABASE=
DB_SAVIO_USER=
DB_SAVIO_PASSWORD=

SUCURSAL_SOMISA_NOMBRE=
DB_SOMISA_SERVER=
DB_SOMISA_PORT=1433
DB_SOMISA_DATABASE=
DB_SOMISA_USER=
DB_SOMISA_PASSWORD=

# Casa central: base con la tabla SECR usada para validar el login (usuario, clave y #DASH en niveles).
DB_CASA_CENTRAL_SERVER=josesavio2.dyndns.info
DB_CASA_CENTRAL_PORT=3341
DB_CASA_CENTRAL_DATABASE=
DB_CASA_CENTRAL_USER=
DB_CASA_CENTRAL_PASSWORD=
